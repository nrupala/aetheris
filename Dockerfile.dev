FROM lscr.io/linuxserver/code-server:latest

USER root

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN HOME=/config curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/config/.cargo/bin:${PATH}"

RUN python3 -m pip install --break-system-packages --no-deps --force-reinstall \
    requests numpy tiktoken fastapi uvicorn httpx pytest

USER abc
