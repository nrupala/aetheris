# Ollama runs locally on Aetheris; the MCP server talks to it directly,
# NOT through the Access-gated public hostname.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text

# Chat model used by rag_answer to compose the grounded, cited answer.
# Pull it locally first: `ollama pull llama3.2` (bootstrap.sh can do this).
CHAT_MODEL=llama3.2

# Where the indexer reads source documents (markdown / text).
CORPUS_DIR=./corpus

# SQLite index of chunks + embeddings.
DB_PATH=./data/index.db

# Bearer token Town must present (Authorization: Bearer <token>).
# bootstrap.sh generates a strong value automatically.
MCP_BEARER_TOKEN=change-me-to-a-long-random-secret

# Bind address/port (behind cloudflared; never exposed directly).
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp

# Chunking.
CHUNK_CHARS=1200
CHUNK_OVERLAP=150

# RAG retrieval knobs (rag_answer).
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
