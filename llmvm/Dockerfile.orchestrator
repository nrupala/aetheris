FROM python:3.12-slim

WORKDIR /workspace

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install orchestrator-specific dependencies
RUN pip install --no-cache-dir fastapi uvicorn aiohttp pydantic

COPY agent_orchestrator/ ./agent_orchestrator/

# Create workspace directories
RUN mkdir -p /workspace/intermediate /workspace/orchestrator_state /workspace/data

ENV WORKSPACE_ROOT=/workspace
ENV LMSTUDIO_ENDPOINT=http://host.docker.internal:1234
ENV OPA_ENDPOINT=http://opa-gateway:8181

EXPOSE 9090

CMD ["python", "-m", "agent_orchestrator.server", "--host", "0.0.0.0", "--port", "9090"]
