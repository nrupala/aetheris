[Unit]
Description=Aetheris Core (native, no Docker)
Documentation=https://github.com/nrupala/aetheris/blob/main/docs/DEPLOY_NATIVE.md
# Ollama runs loopback-only; wait for it and the network before starting.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated, unprivileged service account. scripts/install-native.sh creates the
# `aetheris` user/group (system account, nologin) before enabling this unit.
User=aetheris
Group=aetheris
WorkingDirectory=/data
# Non-secret environment (AI_ENDPOINT, model fallbacks, PORT, OPA, VAULT_PATH).
# Installed from config/core.env.example by scripts/install-native.sh.
EnvironmentFile=/etc/aetheris/core.env
# Boot-assert: fail loudly if the writable data dir (ReadWritePaths=/data below)
# is not actually writable, so a read-only (EROFS) remount cannot regress
# silently. Runs first, inside the sandbox as User=aetheris, so it checks the
# exact write access the service depends on. See infra/systemd/assert-writable.sh.
ExecStartPre=/opt/aetheris/bin/assert-writable.sh /data
# Core binds 127.0.0.1:8080 (loopback); cloudflared fronts it publicly.
ExecStart=/opt/aetheris/bin/aetheris-core
Restart=on-failure
RestartSec=3

# --- Hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# The vault / WAL lives under /data; everything else is read-only.
ReadWritePaths=/data

[Install]
WantedBy=multi-user.target
