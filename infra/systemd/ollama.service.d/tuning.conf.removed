# Drop-in tuning for Ollama on the 24GB Aetheris ARM box.
# Install to: /etc/systemd/system/ollama.service.d/tuning.conf
# then:       systemctl daemon-reload && systemctl restart ollama
[Service]
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NUM_PARALLEL=2
Environment=OLLAMA_KEEP_ALIVE=15m
# Under memory pressure, let the kernel reclaim the (restartable) model server
# before the persistent agent and other services.
OOMScoreAdjust=500
