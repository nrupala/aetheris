# Aetheris Core - native (no-Docker) environment file.
#
# scripts/install-native.sh copies this to /etc/aetheris/core.env if that file does
# not already exist. It contains NO secrets. Every variable below is read by the Rust
# Config struct in core/src/config.rs (Config::from_env).

# --- AI backend (Ollama, loopback only) ---
# The native core reaches Ollama directly on the host loopback - no Docker bridge and
# no 172.28.0.1. Ollama must be bound to 127.0.0.1:11434 (see the ollama.service
# override under infra/systemd/).
AI_ENDPOINT=http://127.0.0.1:11434

# --- Model fallbacks (env-driven; established by merged PR #4) ---
# Generation fallback used when a request specifies no model.
AETHERIS_FALLBACK_MODEL=qwen2.5:7b
# Embedding-model fallback. Must be a real embedding model, never a reasoning LLM.
AETHERIS_EMBED_FALLBACK_MODEL=nomic-embed-text

# --- HTTP listener ---
# Core binds this port on loopback. cloudflared exposes it as
# core.nrupalakolkar.com behind Cloudflare Access.
PORT=8080

# --- Web panels root directory ---
# The core serves per-subdomain panels from here by Host header (ai.* -> ai/,
# rag.* -> rag/, agents.* -> agents/, dev.* -> dev/, apex -> index.html). The
# `aetheris` service user must be able to read this tree (ProtectSystem=strict
# still allows reads from /opt/aetheris).
WEB_ROOT=/opt/aetheris/web

# --- OPA policy engine (loopback; optional) ---
# Native deploy runs OPA on the host loopback rather than a Docker "opa" hostname.
OPA_ENDPOINT=http://127.0.0.1:8181

# --- Data / vault directory ---
# Vault + WAL live here. Must stay inside the unit's ReadWritePaths=/data
# (see infra/systemd/aetheris-core.service).
VAULT_PATH=/data/vault
