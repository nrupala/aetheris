# Aetheris Core — native runtime environment (no Docker)
# Copied to /opt/aetheris/.env.aetheris by scripts/bootstrap-native.sh.
#
# Ollama runs natively on this box (ollama.service) on 127.0.0.1:11434.
# The Docker-era value http://ollama:11434 does NOT resolve without Docker DNS
# and was the cause of ai_connected=false / all embed models failing.
AI_ENDPOINT=http://127.0.0.1:11434
AI_MODEL=qwen2.5:14b

# Open Policy Agent. Install natively (127.0.0.1:8181) if authz enforcement is
# required; if OPA is not running the core will target this and degrade.
OPA_ENDPOINT=http://127.0.0.1:8181

# Absolute vault path so the core does not fall back to a CWD-relative "vault".
VAULT_PATH=/opt/aetheris/vault

PORT=8080
